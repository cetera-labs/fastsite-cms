# Как boilerplate/nginx.conf сайтов на Cetera CMS, но с корнем /var/www/site/www
resolver 127.0.0.11;
server
    {
        listen 80 default_server;
        server_name     _;
        root /var/www/site/www/;
        # редиректы относительные, иначе теряется порт 8090 (внутри контейнера nginx слушает 80)
        absolute_redirect off;
        set $php_sock php:9000;
        include common_fpm_ceteracms.conf;
        error_log /var/log/nginx/error.log;
}
